{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "generated_tasks.schema.json",
  "title": "Task-generation result document (task_generation_result.json)",
  "description": "The document a task_generation subagent prints and the invoker persists under the phase dir. Validated before anything is written to the plan; the semantic rules utils/task_decomposer.py owns (unique T### ids, depends_on naming only declared ids, acyclic, at least one dependency-free task) run in Python immediately after this schema check. A document that fails either is a schema_invalid failure and is not retried.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_preamble": {
      "type": "string",
      "description": "3-5 sentences of shared context injected into every task prompt."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/generated_task"}
    }
  },
  "$defs": {
    "generated_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "depends_on",
        "files_to_create",
        "files_to_modify",
        "acceptance_criteria",
        "estimated_complexity",
        "executor_role"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^T[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "files_to_create": {"type": "array", "items": {"type": "string"}},
        "files_to_modify": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "estimated_complexity": {"enum": ["low", "medium", "high"]},
        "executor_role": {"enum": ["agent", "human"]},
        "subagent_type": {
          "enum": ["general-purpose", "human"],
          "description": "Optional Claude-Code-only metadata; must agree with executor_role."
        }
      },
      "allOf": [
        {
          "if": {"required": ["executor_role"], "properties": {"executor_role": {"const": "human"}}},
          "then": {"properties": {"subagent_type": {"const": "human"}}}
        },
        {
          "if": {"required": ["executor_role"], "properties": {"executor_role": {"const": "agent"}}},
          "then": {"properties": {"subagent_type": {"const": "general-purpose"}}}
        }
      ]
    }
  }
}
