          "permission": {
            "external_directory": {
              "/zz/*": "allow",
              "/shared/*": "allow",
              "/shared/private/*": "deny",
              "*": "ask"
            },
            "*": "allow"
          },
          "agent": {
            "plan": {
              "permission": {
                "external_directory": {
                  "/aa/*": "ask"
                }
              }
            },
            "build": {
              "permission": {
                "external_directory": "deny"
              }
            }
          }
        }
