{
 "opencode_version": "1.19.3",
 "note": "b38de8bb's shape: plan text about rate limits in a completed read, then an auto-rejected bash ends the turn",
 "argv": [
  "opencode",
  "run",
  "--pure",
  "--agent",
  "plan",
  "--format",
  "json",
  "--print-logs",
  "--log-level",
  "ERROR",
  "--model",
  "stub/m",
  "Validate the plan's claims against the repository."
 ],
 "env": {
  "HOME": "/rig/home",
  "XDG_CONFIG_HOME": "/rig/cfg",
  "XDG_DATA_HOME": "/rig/data",
  "XDG_CACHE_HOME": "/rig/cache",
  "XDG_STATE_HOME": "/rig/state",
  "TMPDIR": "/rig/tmp",
  "OPENCODE_DISABLE_MODELS_FETCH": "1",
  "OPENCODE_DISABLE_AUTOUPDATE": "1",
  "OPENCODE_DISABLE_PROJECT_CONFIG": "1"
 },
 "OPENCODE_CONFIG_CONTENT": null,
 "global_opencode_json": {
  "$schema": "https://opencode.ai/config.json",
  "provider": {
   "stub": {
    "npm": "@ai-sdk/openai-compatible",
    "name": "stub",
    "options": {
     "baseURL": "http://127.0.0.1:PORT/v1",
     "apiKey": "x"
    },
    "models": {
     "m": {
      "name": "m",
      "tool_call": true
     }
    }
   }
  },
  "model": "stub/m",
  "small_model": "stub/m"
 },
 "managed_opencode_json": null,
 "org_config": null,
 "stub_tool_call": null,
 "stub_script": {
  "turns": [
   {
    "text": "I'll read the plan sections and check the rate limit claims.",
    "calls": [
     {
      "tool": "read",
      "args": {
       "filePath": "/rig/work/docs/plan.md"
      }
     }
    ]
   },
   {
    "text": "I'll read the host name the plan's deployment section names.",
    "calls": [
     {
      "tool": "bash",
      "args": {
       "command": "cat /etc/hostname",
       "description": "show file"
      }
     }
    ]
   }
  ]
 }
}
